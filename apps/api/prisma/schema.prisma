generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  OWNER
  MEMBER
}

enum InvitationStatus {
  PENDING
  SENT
  ACCEPTED
  FAILED
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMemberships GroupMember[]
  sessions         Session[]
  createdInvitations Invitation[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("session")
}

model Group {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    GroupMember[]
  budgets    Budget[]
  categories ExpenseCategory[]
  expenses   Expense[]
  invitations Invitation[]

  @@map("group")
}

model GroupMember {
  id String @id @default(cuid())

  userId  String
  groupId String

  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  expensesPaid Expense[]

  // A user can belong to a group only once
  @@unique([groupId, userId])

  // Required for composite FK from Expense
  @@unique([groupId, id])

  @@index([userId])
  @@index([groupId])

  @@map("group_member")
}

model Invitation {
  id        String  @id @default(cuid())

  groupId   String
  createdById String

  email     String
  tokenHash String
  status    InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([createdById])
  @@index([email])
  @@index([email, status])

  @@map("invitation")
}

model Budget {
  id      String   @id @default(cuid())
  amount  Decimal
  month   DateTime
  groupId String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One budget per group per month
  @@unique([groupId, month])

  @@index([groupId, month])

  @@map("budget")
}

model ExpenseCategory {
  id       String  @id @default(cuid())
  name     String
  icon     String?
  isActive Boolean @default(true)

  groupId String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  expenses Expense[]

  // Category names must be unique within a group
  @@unique([groupId, name])

  // Required for composite FK from Expense
  @@unique([groupId, id])

  @@index([groupId, isActive])

  @@map("expense_category")
}

model Expense {
  id     String   @id @default(cuid())
  amount Decimal
  note   String?
  spentAt DateTime

  groupId        String
  categoryId     String
  paidByMemberId String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Ensures category belongs to the same group
  category ExpenseCategory @relation(fields: [groupId, categoryId], references: [groupId, id], onDelete: Restrict)

  // Ensures payer belongs to the same group
  paidByMember GroupMember @relation(fields: [groupId, paidByMemberId], references: [groupId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, spentAt])
  @@index([categoryId])
  @@index([paidByMemberId])

  @@map("expense")
}